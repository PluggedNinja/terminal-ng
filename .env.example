# ── Terminal-NG backend config ──
# Port the Express + WebSocket backend listens on
PORT=3001

# Em produção (NODE_ENV=production) o servidor RECUSA subir se os 3 segredos
# abaixo estiverem ausentes/fracos. Gere valores fortes, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
NODE_ENV=development

# Assina os tokens de sessão JWT. Mín. 32 caracteres em produção.
JWT_SECRET=change-me-to-a-long-random-string

# Cifra segredos em repouso (senhas SSH, tokens OAuth, API keys). Mín. 32 caracteres.
# Se mudar esta chave, os segredos já salvos ficam ilegíveis (re-salve-os).
TNG_ENC_KEY=change-me-to-another-long-random-string

# Conta admin criada no primeiro boot. Em produção a senha precisa ter >= 12 caracteres
# e não pode ser "admin". Troque a senha no app após o primeiro login.
ADMIN_USER=admin
ADMIN_PASSWORD=admin

# CORS: origens permitidas em produção (separadas por vírgula), ex.:
#   TNG_ALLOWED_ORIGINS=https://term.seudominio.com
# Vazio = apenas localhost (dev / uso single-origin).
TNG_ALLOWED_ORIGINS=

# ── AI copilot (optional) ──
# Three ways to power the copilot (priority: ChatGPT OAuth > API key > offline heuristic):
#  1) ChatGPT OAuth — click "Connect ChatGPT" in the AI panel (uses your Plus/Pro/Team
#     subscription, no key needed). Works when the backend runs locally (callback on
#     ports 1455/1457). Nothing to set here; optional overrides below.
#  2) API key — set AI_API_KEY for an OpenAI-compatible chat API.
#  3) Neither — offline heuristic command explainer.
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ChatGPT OAuth (Codex) overrides — usually leave default.
# OPENAI_OAUTH_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann
# AI_CODEX_MODEL=gpt-5
