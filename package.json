{
  "name": "terminal-ng",
  "version": "1.0.0",
  "description": "Terminal-NG — Advanced cyberpunk SSH terminal with live parsers and AI copilot",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently -n SERVER,VITE -c magenta,cyan \"node server/index.js\" \"vite\"",
    "vite": "vite",
    "server": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "vite build && node server/index.js",
    "start": "vite build && node server/index.js",
    "build:exe": "node scripts/build-exe.mjs"
  },
  "keywords": [
    "ssh",
    "terminal",
    "xterm",
    "cyberpunk",
    "parsers",
    "ai"
  ],
  "author": "Pedro",
  "license": "MIT",
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "framer-motion": "^11.3.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.436.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ssh2": "^1.15.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.0.0",
    "esbuild": "^0.28.1",
    "postject": "^1.0.0-alpha.6",
    "tailwindcss": "^4.0.0",
    "vite": "^8.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
